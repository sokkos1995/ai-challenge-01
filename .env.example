# Скопируйте в .env и подставьте реальные значения.
# Реальный .env в git не коммитится.

# Обязательное: один из ключей провайдера
# CURSOR_API_KEY=...          # day_41 baseline / synth (предпочтительно)
OPENROUTER_API_KEY=...
# GROQ_API_KEY=...
# LLM_API_KEY=...
# OPENAI_API_KEY=...          # только day_41 fine-tune client --execute (не запускать в ДЗ)

# Опционально: выбор провайдера (auto/openrouter/groq/cursor)
LLM_PROVIDER=auto

# day_41: локальный baseline (если Ollama запущена)
# OLLAMA_MODEL=qwen2.5-coder:7b
# DAY41_BASELINE_PROVIDER=auto   # auto|ollama|cursor

# Опционально: endpoint и модель
# LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
# LLM_MODEL=...
# LLM_FALLBACK_MODELS=...

# day_43: quality routing (cheap → strong), отдельно от availability fallback
# LLM_CHEAP_MODEL=composer-2              # cursor default cheap
# LLM_STRONG_MODEL=composer-2.5           # cursor default strong
# LLM_CHEAP_MODEL=qwen2.5-coder:1.5b      # ollama
# LLM_STRONG_MODEL=qwen2.5-coder:7b
# LLM_ROUTE_MIN_ANSWER_CHARS=24
# LLM_ROUTE_CONFIDENCE_MIN=0.55
# OLLAMA_OPENAI_URL=http://127.0.0.1:11434/v1/chat/completions

# MCP / интеграции
# TODOIST_API_TOKEN=...
# GITHUB_TOKEN=...

# SSL (если нужно)
# SSL_CERT_FILE=...
